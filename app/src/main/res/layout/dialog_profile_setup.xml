<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:gravity="center_horizontal"
    android:background="@android:color/white">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Profile Setup 👤"
        android:textColor="#333333"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Set your name and photo for Mesh network"
        android:textColor="#666666"
        android:textSize="12sp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="16dp" />

    <!-- Gol DP Selection Area -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardDpClick"
        android:layout_width="80dp"
        android:layout_height="80dp"
        app:cardCornerRadius="40dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="#F0F0F0"
        android:foreground="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:id="@+id/imgDialogDp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@android:drawable/ic_menu_camera"
            app:tint="#4B39EF" />
    </androidx.cardview.widget.CardView>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tap photo to select from gallery"
        android:textColor="#4B39EF"
        android:textSize="11sp"
        android:layout_marginTop="6dp" />

    <EditText
        android:id="@+id/etDialogNickname"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Enter your Nickname"
        android:inputType="textPersonName"
        android:layout_marginTop="16dp"
        android:padding="12dp"
        android:background="@android:drawable/editbox_background" />

    <Button
        android:id="@+id/btnSaveProfile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Save Profile"
        android:textColor="@android:color/white"
        android:backgroundTint="#4B39EF"
        android:layout_marginTop="16dp"
        app:cornerRadius="8dp" />

</LinearLayout>